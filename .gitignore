# --- environments -----------------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
*.egg-info/

# --- OS ----------------------------------------------------------------------
.DS_Store
Thumbs.db

# --- editors -----------------------------------------------------------------
.idea/
.vscode/
*.swp

# --- generated artefacts -----------------------------------------------------
# Everything below is rebuilt deterministically from the committed corpus, the
# committed config and a recorded seed, so it is derived data, not source.
data/processed/clauses.jsonl
data/processed/index/
data/processed/probes/*/probes.jsonl
data/processed/checklists/*_draft.json

# Response logs are DELIBERATELY NOT ignored. They are the one artefact that
# cannot be regenerated — a probe comes back from a seed, a response is a
# purchase — and a few thousand of them is only a handful of megabytes. On an
# ephemeral machine, git is the backup. Losing this file means paying for the
# whole run again.
#   data/processed/runs/*/responses.jsonl   <- committed on purpose

# Deliberately NOT ignored, because they are provenance rather than output:
#   data/processed/checklists/*_signed.json  — the notary signature is the trust root
#   data/processed/probes/*/manifest.json    — seed, generator version, content hash

# --- run scaffolding ----------------------------------------------------------
# Sweep logs and the lock directory are operational noise, not provenance. What
# a model answered is in the response log; how the shell felt about it is not.
logs/
.grail-cache/

# --- model caches ------------------------------------------------------------
.cache/
models/
*.safetensors
*.bin

# --- editor lock files and ledger snapshots ----------------------------------
~$*
data/processed/runs/*/ledger.jsonl.*.bak
data/processed/runs/*/*.partial.jsonl

# --- downloaded record sources -------------------------------------------------
# NHANES raw files (about 40 MB) are re-downloadable by scripts/fetch_nhanes.py
# and verified against raw/MANIFEST.json, which IS committed. The decoded
# data/records/nhanes/applicants.jsonl and PROVENANCE.json are committed: the
# probe set depends on them and their hashes are registered (Amendment A1.1).
data/records/nhanes/raw/*.xpt
data/records/nhanes/raw/*.dat
data/records/nhanes/raw/*.part

# --- LaTeX build files (main.pdf is kept) ---------------------------------------
thesis/*.aux
thesis/*.bbl
thesis/*.blg
thesis/*.lof
thesis/*.log
thesis/*.lol
thesis/*.lot
thesis/*.out
thesis/*.toc
thesis/*.synctex.gz

# NHANES records stay local (rebuild: fetch_nhanes.py + import_nhanes.py)
data/records/nhanes/

# CAL1 answer key: never published (copy in the vault, hash in KEY.sha256)
data/processed/annotation/insurance/KEY_do_not_open_until_scored.json
